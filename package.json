{
  "name": "blekit",
  "version": "1.2.0",
  "description": "React Native BLE SDK",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "license": "MIT",
  "private": false,
  "packageManager": "bun@1.3.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manojgowdain/blekit.git"
  },
  "files": [
    "dist",
    "src/bgnp.cjs",
    "src/bgnp.js"
  ],
  "scripts": {
    "test": "tsc --noEmit",
    "build": "tsup"
  },
  "expo": {
    "plugin": "./src/bgnp.cjs"
  },
  "keywords": [
    "react-native",
    "ble",
    "bluetooth",
    "expo"
  ],
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-community/netinfo": "^12.0.1",
    "axios": "^1.18.1",
    "base-64": "^1.0.0",
    "expo-background-fetch": "^57.0.5",
    "expo-battery": "^57.0.1",
    "expo-device": "^57.0.1",
    "expo-location": "^57.0.8",
    "expo-notifications": "^57.0.7",
    "expo-task-manager": "^57.0.5",
    "expo-updates": "^57.0.10",
    "react-native-background-actions": "^4.1.0",
    "react-native-ble-plx": "^3.5.1",
    "react-native-device-info": "^15.0.2",
    "react-native-get-random-values": "^2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.1.2",
    "@types/react-native": "^0.72.8",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./src/bgnp": "./src/bgnp.cjs",
    "./plugin": "./src/bgnp.cjs"
  }
}
