{
  "name": "blekit",
  "version": "1.2.1",
  "description": "React Native BLE SDK",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "license": "MIT",
  "private": false,
  "packageManager": "bun@1.3.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manojgowdain/blekit.git"
  },
  "files": [
    "dist",
    "src/bgnp.cjs",
    "src/bgnp.js"
  ],
  "scripts": {
    "test": "tsc --noEmit",
    "build": "tsup"
  },
  "expo": {
    "plugin": "./src/bgnp.cjs",
    "expo-doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-background-actions"
        ]
      }
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-background-actions"
        ]
      }
    }
  },
  "keywords": [
    "react-native",
    "ble",
    "bluetooth",
    "expo"
  ],
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "axios": "^1.18.1",
    "base-64": "^1.0.0",
    "expo": "^57.0.9",
    "expo-application": "~57.0.3",
    "expo-asset": "^57.0.19",
    "expo-audio": "^57.0.5",
    "expo-background-fetch": "~57.0.21",
    "expo-battery": "~57.0.3",
    "expo-constants": "~57.0.21",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-intent-launcher": "~57.0.1",
    "expo-location": "~57.0.21",
    "expo-notifications": "~57.0.22",
    "expo-task-manager": "~57.0.21",
    "expo-updates": "~57.0.26",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-background-actions": "^4.1.0",
    "react-native-ble-plx": "^3.5.1",
    "react-native-device-info": "^15.0.2",
    "react-native-get-random-values": "~1.11.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.1.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./useOtaUpdate": {
      "types": "./dist/src/useOtaUpdate.d.ts",
      "import": "./dist/src/useOtaUpdate.mjs",
      "require": "./dist/src/useOtaUpdate.js"
    },
    "./src/bgnp": "./src/bgnp.cjs",
    "./plugin": "./src/bgnp.cjs"
  }
}
