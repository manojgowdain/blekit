{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "outDir": "./dist",
    "allowJs": true,
    "jsx": "react-native",
    "ignoreDeprecations": "6.0"
  },
  "include": ["src", "index.ts"],
  "exclude": ["node_modules", "dist"]
}
